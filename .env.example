# 通用配置。provider 可选 krill、aixoras、custom；命令行参数优先级更高。
IMAGE_API_PROVIDER=krill

# Krill（旧配置继续兼容）
KRILL_AI_API_KEY=replace-with-your-api-key
KRILL_AI_BASE_URL=https://api.krill-ai.net/v1
KRILL_AI_MODEL=gpt-image-2

# Aixoras：默认使用已验证的同步文生图，NEWAPI_TOKEN 也可作为 AIXORAS_API_KEY 的别名。
AIXORAS_API_KEY=replace-with-your-api-key
AIXORAS_API_BASE_URL=https://api.aixoras.com/v1
AIXORAS_API_MODEL=gpt-image-2

# 可选的跨供应商覆盖项
# IMAGE_API_KEY=replace-with-your-api-key
# IMAGE_API_BASE_URL=https://example.com/v1
# IMAGE_API_MODEL=gpt-image-2
# IMAGE_API_MODE=async
# IMAGE_API_ASPECT_RATIO=1:1
# IMAGE_API_RESPONSE_FORMAT=url
# IMAGE_API_WATERMARK=false
