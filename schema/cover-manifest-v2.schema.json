{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaq152.github.io/HowToCook-assets/schema/cover-manifest-v2.schema.json",
  "title": "HowToCook Recipe Cover Manifest V2",
  "type": "object",
  "required": [
    "schemaVersion", "mediaType", "coverVersion", "dataVersion", "generatedAt",
    "sourceDataManifest", "promptVersion", "totalCovers", "totalBytes", "covers"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "mediaType": { "const": "recipe-cover" },
    "coverVersion": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+$" },
    "dataVersion": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceDataManifest": { "type": "string", "pattern": "^versions/2/.+/manifest\\.json$" },
    "promptVersion": { "type": "string", "minLength": 1 },
    "totalCovers": { "type": "integer", "minimum": 1 },
    "totalBytes": { "type": "integer", "minimum": 1 },
    "covers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "recipeId", "recipeName", "category", "recipeHash", "path", "width", "height",
          "bytes", "sha256", "generationMode", "referenceImage", "provider", "model",
          "promptVersion", "promptHash"
        ],
        "properties": {
          "recipeId": { "type": "string", "format": "uuid" },
          "recipeName": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "recipeHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "path": { "type": "string", "pattern": "^images/.+\\.webp$" },
          "width": { "type": "integer", "minimum": 256 },
          "height": { "type": "integer", "minimum": 256 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "generationMode": { "const": "generate" },
          "referenceImage": { "const": null },
          "provider": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "promptVersion": { "type": "string", "minLength": 1 },
          "promptHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
