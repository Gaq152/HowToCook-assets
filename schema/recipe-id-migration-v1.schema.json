{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaq152.github.io/HowToCook-assets/schema/recipe-id-migration-v1.schema.json",
  "title": "HowToCook Recipe ID Migration",
  "type": "object",
  "required": ["schemaVersion", "migrationId", "fromSchemaVersion", "toSchemaVersion", "dataVersion", "mappings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "migrationId": { "type": "string" },
    "fromSchemaVersion": { "const": 1 },
    "toSchemaVersion": { "const": 2 },
    "dataVersion": { "type": "string" },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["oldId", "newId", "category", "name"],
        "properties": {
          "oldId": { "type": "string" },
          "newId": { "type": "string", "format": "uuid" },
          "category": { "type": "string" },
          "name": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
