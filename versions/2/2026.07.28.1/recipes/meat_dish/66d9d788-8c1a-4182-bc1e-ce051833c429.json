  "calculationMarkdown": "每份：\r\n\r\n- 五花肉 500g\r\n- 朝天椒 4 条\r\n- 小米椒 4 颗\r\n- 豆豉 10g，根据个人口味加减 ±5g\r\n- 豆瓣酱 10g，根据个人口味加减 ±5g\r\n- 老抽 10ml\r\n- 淀粉 10g\r\n- 盐 1-2g\r\n- 葱 0.5-1 根\r\n- 蒜 2 瓣\r\n- 食用油 15ml",
  "calculationNotes": [
    "每份："
  ],
  "steps": [
    {
      "kind": "step",
      "description": "五花肉切片"
    },
    {
      "kind": "step",
      "description": "把肉放入器皿内，加入淀粉、老抽、盐搅拌腌制半小时"
    },
    {
      "kind": "step",
      "description": "葱切段"
    },
    {
      "kind": "step",
      "description": "小米椒、朝天椒斜刀切好"
    },
    {
      "kind": "step",
      "description": "热锅、倒油"
    },
    {
      "kind": "step",
      "description": "油热后加入五花肉煸炒。炒至变色后盛出来"
    },
    {
      "kind": "step",
      "description": "向锅中加蒜，煸出香味，加入豆豉，翻炒均匀"
    },
    {
      "kind": "step",
      "description": "加入豆瓣酱翻炒均匀"
    },
    {
      "kind": "step",
      "description": "加入炒好的五花肉继续的翻炒均匀"
    },
    {
      "kind": "step",
      "description": "加入小米椒、朝天椒、葱段翻炒 40 秒"
    },
    {
      "kind": "step",
      "description": "出锅。"
    }
